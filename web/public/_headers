# The build names every file under /assets/ by its content, so a browser may keep it for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The build fills in the content policy with the hash of every inline script it wrote
# (`contentSecurityPolicy` in vite.config.ts). No page is meant to be framed: the
# extension bridge navigates to the extension, it never embeds the site.
/*
  Content-Security-Policy: __CONTENT_SECURITY_POLICY__
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
