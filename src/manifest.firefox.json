{
  "manifest_version": 3,
  "name": "Fourches Caudines - Analyse critique de presse",
  "version": "0.1.0",
  "description": "Évalue et vérifie la rigueur logique, factuelle et argumentative des articles de presse.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": ["src/background/index.ts"],
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    },
    "default_title": "Analyser cet article avec Fourches Caudines"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/index.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    },
    "default_title": "Fourches Caudines"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fourches-caudines@presse-critique.fr",
      "strict_min_version": "115.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*",
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
