{
  "manifest_version": 3,
  "name": "Squiggle - Analyse critique de presse",
  "description": "Un deuxième avis sur l’article que vous lisez : passages fragiles surlignés, raisons, note sur 100. Gratuit avec votre clé d’API.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "src/background/index.ts"
    ],
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    },
    "default_title": "Analyser cet article avec Squiggle"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/index.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    },
    "default_title": "Squiggle"
  },
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "squiggle@presse-critique.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*",
        "fonts/*",
        "squiggle-auth.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}