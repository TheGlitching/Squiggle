{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squiggle-server",
  "main": "src/index.ts",
  // Bump when the runtime gains new features we start relying on.
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  // One Worker serves the API and the web app, so the app and the API share an
  // origin (see web/src/api.ts). `web/dist` is built by `npm run build:web`
  // before every deploy. Only the API namespaces below reach the Worker; every
  // other path is a static file. The build writes one for every address the
  // web app answers, /compte and /pont included (APP_PATHS in web/src/seo.ts),
  // so a path with no file is a mistyped or dead link and gets 404.html with a
  // 404 status, not the home page. A new top-level route in src/index.ts has
  // to be added here, and a web route must not start with one of these
  // prefixes; tests/deploy.test.ts checks both.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health", "/auth/*", "/v1/*", "/web/*", "/webhooks/*", "/admin/*"]
  },
  // Deploy with --env (`npm run deploy:staging`, `npm run deploy:production`).
  // Wrangler does not inherit `vars`, so each environment carries the full set,
  // and tests/deploy.test.ts keeps the two key sets identical.
  //
  // Non-secret configuration only. Everything sensitive (DATABASE_URL,
  // BREVO_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, OPENROUTER_API_KEY,
  // GEMINI_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN, METRICS_TOKEN, OWNER_EMAILS) is
  // set per environment with `wrangler secret put --env <name>` and lives in
  // the Cloudflare secret store, never in this file, never in the repo (see
  // AGENTS.md). So is EXTENSION_CHROME_ORIGIN, the origin CORS is pinned to for
  // the Chrome listing: not sensitive, but it is a real extension id, which the
  // repo never carries. The optional EXTENSION_EDGE_ORIGIN, for the Edge listing,
  // is set the same way. Firefox has no such value (see src/lib/cors.ts).
  // `GEMINI_MODEL` is an optional var, set only to select Gemini.
  //
  // A value that is not decided yet is a PENDING_… placeholder, and
  // `npm run deploy:production` refuses to ship one (scripts/deploy.mjs).
  "env": {
    "staging": {
      "name": "squiggle-server-staging",
      "workers_dev": true,
      // Retention sweeps (see runScheduled): hourly, and daily at DAILY_CRON.
      "triggers": {
        "crons": ["0 * * * *", "17 3 * * *"]
      },
      // A message forwarded to the e-mail address is audited in the email()
      // handler, then finishes (research, report, reply) from this queue, one
      // job at a time; a job runs MAIL_JOB_ATTEMPTS times at most
      // (src/mail/inbound.ts). The queue is created once per account, before
      // the first deploy that carries it (docs/DEPLOYING.md).
      "queues": {
        "producers": [{ "binding": "MAIL_QUEUE", "queue": "squiggle-mail-in-staging" }],
        "consumers": [{ "queue": "squiggle-mail-in-staging", "max_batch_size": 1, "max_retries": 2 }]
      },
      "vars": {
        // The staging Worker's own address; the workers.dev subdomain is the
        // account's, so it is filled in once the account exists.
        "WEB_APP_ORIGIN": "https://squiggle-server-staging.PENDING_WORKERS_SUBDOMAIN.workers.dev",
        "BREVO_FROM_ADDRESS": "no-reply@squiggle.fr",
        "LLM_PROVIDER": "openrouter",
        "OPENROUTER_MODEL": "deepseek/deepseek-v4.1-flash",
        // The minutes of sound staging may have transcribed in a day (see production).
        "TRANSCRIBE_DAILY_MINUTES": "60",
        // Reading publications on X (see production). Staging has no X_BEARER_TOKEN
        // unless one is set, and then a link to X is read like any other link.
        "X_DAILY_CAP_USD": "0.5",
        "X_ACCOUNT_DAILY_CAP_USD": "0.1",
        // The Stripe test-mode price: staging never talks to live billing.
        "STRIPE_PRICE_ID": "PENDING_TEST_PRICE_ID",
        // The test-mode teacher coupon (see production). None exists yet, so
        // the offer stays closed on staging.
        "STRIPE_TEACHER_COUPON_ID": "PENDING_TEST_TEACHER_COUPON_ID"
      }
    },
    "production": {
      "name": "squiggle-server-production",
      "workers_dev": false,
      "routes": [{ "pattern": "squiggle.fr", "custom_domain": true }],
      // Retention sweeps (see runScheduled): hourly, and daily at DAILY_CRON.
      "triggers": {
        "crons": ["0 * * * *", "17 3 * * *"]
      },
      // A message forwarded to the e-mail address is audited in the email()
      // handler, then finishes (research, report, reply) from this queue, one
      // job at a time; a job runs MAIL_JOB_ATTEMPTS times at most
      // (src/mail/inbound.ts). The queue is created once per account, before
      // the first deploy that carries it (docs/DEPLOYING.md).
      "queues": {
        "producers": [{ "binding": "MAIL_QUEUE", "queue": "squiggle-mail-in-production" }],
        "consumers": [{ "queue": "squiggle-mail-in-production", "max_batch_size": 1, "max_retries": 2 }]
      },
      "vars": {
        // Origin of the hosted web app; used to build magic-link / OAuth URLs.
        "WEB_APP_ORIGIN": "https://squiggle.fr",
        // Verified sender address in the Brevo account (not a secret).
        "BREVO_FROM_ADDRESS": "no-reply@squiggle.fr",
        // Which provider hosted analyses run on. `openrouter` is the default and
        // `gemini` is kept selectable; an unknown value leaves the client unset,
        // and the analyze route refuses rather than silently picking a provider.
        // The matching API key is an `OPENROUTER_API_KEY` / `GEMINI_API_KEY`
        // secret, and the provider's key must be present or hosted mode refuses.
        "LLM_PROVIDER": "openrouter",
        // The exact OpenRouter model id hosted analyses run on. It is part of the
        // shared cache key, so changing it invalidates every cached report, which
        // is the intent: the same article judged by a different model is a
        // different report. OpenRouter ids are not predictable from the model
        // name, so this one is copied verbatim from the live catalogue.
        "OPENROUTER_MODEL": "deepseek/deepseek-v4.1-flash",
        // The spending cap of transcription: the minutes of sound the site may
        // have transcribed in a UTC day, all accounts together. At 0.0035 $ a
        // minute (HOSTED_TRANSCRIPTION), 600 minutes is 2.10 $ a day at most.
        "TRANSCRIBE_DAILY_MINUTES": "600",
        // The spending caps of reading publications on X, in dollars per UTC day:
        // all readers together, and one account (or one visitor). X bills
        // 0.005 $ a publication read and 0.010 $ an author, once a day each, so a
        // 25-publication thread costs 0.135 $ at most. The secret X_BEARER_TOKEN
        // opens the feature; without it a link to X is read like any other link.
        "X_DAILY_CAP_USD": "2",
        "X_ACCOUNT_DAILY_CAP_USD": "0.25",
        // The recurring price the subscription is sold at. A `price_…` id is not
        // a secret (it is visible in any Checkout URL), but it is environment
        // specific, so it lives here rather than in code. Filled in from the
        // Stripe dashboard (issue #5).
        "STRIPE_PRICE_ID": "price_1UUZJ21VvAeMihPA3JsE9s6m",
        // The coupon the self-service teacher offer applies at Checkout
        // (src/billing/teacher.ts): 100 % off, repeating for 12 months, at most
        // 100 redemptions, redeemable until 30 June 2027. The subscription
        // itself is set to end on 30 June by the webhook; the coupon's 12 months
        // only bound it should that ever fail. A coupon id is not a secret: it
        // grants nothing without a verified academic address on our side.
        "STRIPE_TEACHER_COUPON_ID": "B2AcWPHo"
      }
    }
  }
}
